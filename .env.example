# QDS-Factory environment reference.
#
# Copy to `.env` and fill in. Every UNCOMMENTED variable here has a working
# default in code, so an empty .env is a valid configuration — the values below
# are overrides. (SWARMCLAW_AUTH_TOKEN is commented out: blank is a startup
# refusal for it, not a default. See its note.)
# Placeholders only: this file is COMMITTED. Never put a real token in it.
#
# NOT DOCUMENTED HERE:
#   * FAKE_MCP_* (22 vars) — test fixtures read only by
#     tests/swarmclaw/fixtures/fake-mcp-server.ts and fake-hindsight-mcp.ts to
#     script a misbehaving MCP server (hangs, garbage frames, exit codes). They
#     are set per-test and have no meaning at runtime.
#   * OS-provided vars (HOME, PATH, CI) and one-off test probes
#     (X, MY_ALLOWED, PIDFILE, HINDSIGHT_INTERNAL, DSN, FOO, FLAG, ...).
#   * HINDSIGHT_API_LLM_API_KEY — not a process env var here; it is a key inside
#     an MCP registration payload's `env` map, used to assert redaction.

# ─────────────────────────────────────────────────────────────────────────────
# SwarmClaw — src/swarmclaw/
# ─────────────────────────────────────────────────────────────────────────────

# HTTP listen port. Default 3100. Must parse as an integer 0-65535 or the
# server refuses to start. (src/swarmclaw/index.ts:300)
SWARMCLAW_PORT=3100

# HTTP listen address. Default 127.0.0.1 — SwarmClaw's routes spawn subprocesses
# and proxy arbitrary MCP tool calls into them, so the listener stays on the
# loopback. Setting this is the ONLY waiver. Blank or whitespace-only = the
# 127.0.0.1 default, NOT all interfaces. Any non-loopback value (0.0.0.0, a LAN
# address; loopback is 127.0.0.1 / ::1 / localhost) exposes that surface
# off-host and REQUIRES SWARMCLAW_AUTH_TOKEN — startup refuses the pairing
# otherwise, it is not a warning. (src/swarmclaw/index.ts:44)
SWARMCLAW_BIND=127.0.0.1

# Bearer credential for the SwarmClaw HTTP surface. Default: UNSET — no
# authentication (loopback-only is then the sole control). When set, EVERY
# request must carry `Authorization: Bearer <value>`; the check runs before the
# body-size guard, so an unauthenticated caller gets 401, never 413. Compared
# in constant time, and the whole header is compared, so the scheme match is
# byte-exact (`bearer x` is rejected).
#
# Left COMMENTED OUT deliberately — unlike every other variable here, a
# set-but-blank value is not "the default". Startup REFUSES it, because a
# sourced .env or `docker --env-file` would otherwise silently boot the server
# unauthenticated. Uncomment only with a real value.
# (src/swarmclaw/index.ts:214)
#SWARMCLAW_AUTH_TOKEN=

# Base URL clients use to reach SwarmClaw. The gate defaults to
# http://127.0.0.1:3100 (src/gate/assertions/p0-7-mcp-bridge.ts:35); the bank
# provisioning script defaults to http://127.0.0.1:3000
# (scripts/provision-hindsight-banks.ts:75). Set it explicitly to avoid the split.
SWARMCLAW_BASE_URL=http://127.0.0.1:3100

# Extra commands SwarmClaw may spawn for a stdio MCP server, comma-separated.
# MERGED with the built-in allowlist (hindsight-local-mcp, node, npx,
# node_modules/.bin/hindsight-local-mcp) — it never replaces it. Relative
# path-like entries are resolved against the install root, not the cwd.
# Default: unset (built-ins only). (src/swarmclaw/mcp/stdio-transport.ts:82)
SWARMCLAW_COMMAND_ALLOWLIST=

# npx packages SwarmClaw may run, comma-separated. Unlike the command
# allowlist this REPLACES the default (hindsight-local-mcp,
# @anthropic-ai/claude-code); a set-but-empty value denies all npx packages.
# (src/swarmclaw/mcp/stdio-transport.ts:98)
SWARMCLAW_NPX_PACKAGE_ALLOWLIST=

# Allowlisted commands whose args may be passed through unvalidated,
# comma-separated basenames matched EXACTLY, case-sensitively — the basename of
# the command, never a path. Only `node` and `npx` have real arg validators;
# for any other allowlisted command args are refused outright unless its
# basename is named here. Default: unset — no command takes args.
# (src/swarmclaw/mcp/stdio-transport.ts:260)
SWARMCLAW_ARG_POLICY=

# Parent-process env keys that may be forwarded into an MCP subprocess,
# comma-separated. Default: empty — subprocesses inherit NOTHING except a
# trusted PATH plus the explicit env in the registration payload (INV-SC3).
# (src/swarmclaw/mcp/stdio-transport.ts:273)
SWARMCLAW_ENV_ALLOWLIST=

# TTL for the MCP tool-enumeration cache, ms. Default 300000 (5 min), clamped
# to [1000, 3600000]; non-numeric falls back to the default.
# (src/swarmclaw/mcp/tool-bridge.ts:121)
SWARMCLAW_TOOL_CACHE_TTL_MS=300000

# Deadline for a single bridged MCP tool invocation, ms. Default 120000,
# clamped to [60000, 3600000]. (src/swarmclaw/mcp/tool-bridge.ts:475)
SWARMCLAW_INVOKE_TIMEOUT_MS=120000

# NOT read by SwarmClaw itself. It exists as the canonical name for a
# parent-process secret, and tests/swarmclaw/agent-mcp-registration.test.ts
# asserts it never leaks into an MCP subprocess env. Leave unset unless you are
# deliberately exercising that isolation check.
SWARMCLAW_INTERNAL_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Hindsight memory service — src/hindsight/
# ─────────────────────────────────────────────────────────────────────────────

# Hindsight API root. Default http://127.0.0.1:8888 (src/hindsight/client.ts:48).
# Note: :8888 collides with Jupyter on some dev boxes — the gate detects this
# and reports it rather than false-greening.
HINDSIGHT_BASE_URL=http://127.0.0.1:8888

# Bearer credential for Hindsight. BEARER_TOKEN is checked first, API_KEY is
# the fallback; both are sent as `Authorization: Bearer <value>`. Default:
# unset (no auth header). (src/hindsight/client.ts:98-99)
HINDSIGHT_BEARER_TOKEN=
HINDSIGHT_API_KEY=

# Any truthy value turns on a masked env diagnostic in Hindsight error logs
# (values are masked, keys are not). Default: unset/off.
# (src/hindsight/client.ts:341)
HINDSIGHT_DEBUG=

# ─────────────────────────────────────────────────────────────────────────────
# Pi coms — pi-vs-claude-code-vendor/ and cli-anything/
# Numeric vars go through envBoundedInt() (coms-core.ts:57): non-finite, <= 0,
# or (where integer:true) non-integer input silently falls back to the default;
# valid input is then clamped into the stated range.
# ─────────────────────────────────────────────────────────────────────────────

# ── Unix-socket transport (coms.ts) ──

# Root for coms socket + registry files. Default ~/.pi/coms. Keep it short:
# Unix socket paths are length-capped. (coms.ts:64)
PI_COMS_DIR=

# coms_await reply timeout, ms. Default 1800000 (30 min), integer, max 2147483647.
# cli-anything's team runner overrides this per-run from the manifest, and its
# own driver applies a 240000 default instead. (coms.ts:65,
# cli-anything/scripts/team-lead-driver.ts:286, cli-anything/src/runner.ts:870)
PI_COMS_TIMEOUT_MS=1800000

# Per-turn deadline, ms. Default 1800000 (30 min), integer, max 2147483647. (coms.ts:69)
PI_COMS_TURN_DEADLINE_MS=1800000

# Liveness ping interval, ms. Default 10000, integer, max 2147483647, then
# floored at 1000. (coms.ts:72)
PI_COMS_PING_INTERVAL_MS=10000

# How long a booting agent waits on the init latch, ms. Default 30000,
# integer, max 2147483647. (coms.ts:106)
PI_COMS_INIT_LATCH_TIMEOUT_MS=30000

# ── HTTP/SSE transport (coms-net.ts) ──

# coms-net server URL. No default: resolution order is --server-url flag, then
# this var, then the project's server.json; null if none resolve. (coms-net.ts:557)
PI_COMS_NET_SERVER_URL=

# coms-net bearer token. Resolution order: --auth-token flag, this var, then the
# project's stored secret. Default: unset. (coms-net.ts:571)
PI_COMS_NET_AUTH_TOKEN=

# coms-net project namespace. Default "default". (coms-net.ts:1942)
PI_COMS_NET_PROJECT=default

# SSE heartbeat interval, ms. Default 10000, clamped to [1000, 300000].
# The SSE watchdog tears down a connection after 3x this. (coms-net.ts:64)
PI_COMS_NET_HEARTBEAT_MS=10000

# Queued-message TTL, ms. Default 1800000 (30 min), clamped to [1000, 86400000]
# (24h). (coms-net.ts:67)
PI_COMS_NET_MESSAGE_TTL_MS=1800000

# coms-net init latch timeout, ms. Default 30000, clamped to [1000, 300000].
# (coms-net.ts:98)
PI_COMS_NET_INIT_LATCH_TIMEOUT_MS=30000

# ── Set BY the extension, not by you ──
# The coms extensions inject these into their own short-lived delivery children.
# Listed for grep-completeness; setting them by hand has no useful effect.
# PI_COMS_EXIT_ENDPOINT     socket path the exit-delivery script writes to (coms.ts:2891)
# COMS_NET_DELIVER_URL      delivery endpoint for the coms-net child (coms-net.ts:3356)
# COMS_NET_DELIVER_TOKEN    bearer for that child — never set this yourself (coms-net.ts:3356)

# ─────────────────────────────────────────────────────────────────────────────
# cli-anything — multi-agent CLI runner
# ─────────────────────────────────────────────────────────────────────────────

# "local" swaps the warren-server dispatch for the local subprocess-RPC driver.
# Any other value (including unset) means "warren". (cli-anything/src/runner.ts:727)
QDS_TEAM_RUNNER=

# SIGTERM->SIGKILL grace period, ms. Default 5000 (WATCHDOG_GRACE_MS); accepted
# only in [0, 60000], anything else falls back to the default.
# (cli-anything/src/runner.ts:688)
QDS_TEAM_GRACE_MS=5000

# JSON team config (lead, workers, turnCap) handed to the team-lead driver.
# The runner SETS this from the manifest; the driver exits 64 if it is missing
# or unparseable. Only set it by hand when driving team-lead-driver.ts directly.
# (cli-anything/src/runner.ts:701, cli-anything/scripts/team-lead-driver.ts:662)
QDS_AGENT_TEAM_CONFIG_JSON=

# Provider keys read from the ambient environment and passed to agent CLIs.
# The runner logs only their presence, never their values (INV-1).
# (cli-anything/src/runner.ts:722)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# pi-lens / LSP verification — scripts/
# ─────────────────────────────────────────────────────────────────────────────

# Explicit pi-lens install root. Tried first, then repo-local
# node_modules/pi-lens, then the global probe. Default: unset.
# (scripts/lsp-verify.ts:183)
PI_LENS_ROOT=

# Node binary used to run the pi-lens MCP server. Default: `node` on PATH,
# falling back to process.execPath. (scripts/lib/mcp-stdio-client.ts:38)
PILENS_NODE=

# pi-lens project data dir. Default ~/.pi-lens/projects (a pre-existing
# ./.pi-lens dir wins when this is unset). The verify scripts set it to a
# run-local temp dir. (scripts/lib/pi-lens-harness.ts:133)
PILENS_DATA_DIR=

# MCP `initialize` handshake deadline, seconds. Default 15; a non-positive or
# non-numeric value logs a note and falls back to 15. (scripts/lsp-verify.ts:149)
LSP_INIT_TIMEOUT_S=15

# ─────────────────────────────────────────────────────────────────────────────
# coms smoke test — scripts/coms-smoke-test.ts
# ─────────────────────────────────────────────────────────────────────────────

# Model passed as `--model` to every spawned pi. Default: unset (pi's own default).
# (scripts/coms-smoke-test.ts:81)
PI_SMOKE_MODEL=

# Strict mode is the DEFAULT. Only the exact value "0" relaxes it, and it waives
# exactly one check (socket_live_round_trip), reporting pass_with_waiver.
# (scripts/coms-smoke-test.ts:1408)
PI_SMOKE_STRICT=

# Set to 1 to deliberately pass the FULL ambient env (every credential) to the
# spawned pi processes; otherwise the smoke test fails closed with an
# `env_scope` error when no provider key can be identified from PI_SMOKE_MODEL.
# (scripts/coms-smoke-test.ts:194)
PI_SMOKE_ALLOW_FULL_ENV=

# ─────────────────────────────────────────────────────────────────────────────
# Dark Factory v5 control plane — src/fleet/, src/providers/, src/phase-engine/
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter PROVISIONING key — NOT a normal API key. It is the credential the
# provider layer uses to CREATE a per-run API key before a box starts and to
# DELETE it on teardown, and it can list and revoke every other key on the
# account. Treat it as the account's master key: never hand it to an agent, and
# never set it in an environment that only needs to make inference calls (those
# take the minted OPENROUTER_API_KEY instead). Default: unset — key minting is
# refused without it. (src/providers/credentials.ts:600)
OPENROUTER_PROVISIONING_KEY=

# Root for per-run records. Default .sandbox/runs (an empty value folds back to
# the default). (src/providers/run-record.ts:770)
QDS_RUNS_DIR=

# Path to the append-only SQLite cost ledger. Default .sandbox/cost-ledger.db.
# (src/providers/cost-ledger.ts:755)
QDS_COST_LEDGER_FILE=

# Path to the per-issue quota/limits JSON. Default .sandbox/quota-limits.json.
# (src/providers/quota.ts:105)
QDS_QUOTA_LIMITS_FILE=

# Directory for best-of-n fan-out records. Default .sandbox/fanouts.
# (src/fleet/fanout.ts:70)
QDS_FANOUTS_DIR=

# Per-invocation timeout for the pi roster probe, ms. A non-finite or
# out-of-range value falls back to the built-in default.
# (src/phase-engine/roster/validate.ts:578)
QDS_PI_TIMEOUT_MS=

# Default provider driver name. Default "exedev" for the cap-hit demo, "fake"
# for the reaper CLI; `--driver` overrides either.
# (scripts/cap-hit-demo.ts:1255, scripts/sandbox-reap.ts:128, scripts/sandbox-teardown.ts:175)
QDS_PROVIDER_DRIVER=

# Directory the cap-hit demo writes its evidence artifacts to.
# Default .sandbox/evidence. (scripts/cap-hit-demo.ts:261, scripts/cap-hit-demo.ts:1276)
QDS_EVIDENCE_DIR=

# Path to the pi models.json the demo reads model metadata from.
# Default ~/.pi/agent/models.json. (scripts/cap-hit-demo.ts:503)
QDS_MODELS_JSON=

# Runs per arm for the lean-worker benchmark. Default MIN_RUNS_PER_ARM; a
# non-numeric value is rejected rather than silently becoming NaN.
# (scripts/lean-worker-benchmark.ts:577)
QDS_BENCH_RUNS=

# ─────────────────────────────────────────────────────────────────────────────
# Phase-0 exit gate — src/gate/
# ─────────────────────────────────────────────────────────────────────────────

# Repo slug used to derive the Hindsight bank id and to tag Mulch imports.
# Default: basename(process.cwd()); the gate's own fallback is "qds-factory".
# (scripts/provision-hindsight-banks.ts:63, src/gate/assertions/p0-9-memory.ts:44)
QDS_REPO_SLUG=

# Hindsight bank the gate round-trips against. Default: derived from
# QDS_REPO_SLUG. (src/gate/assertions/p0-9-memory.ts:44)
QDS_GATE_BANK=

# ─────────────────────────────────────────────────────────────────────────────
# Test-run logging
# ─────────────────────────────────────────────────────────────────────────────

# Any non-empty value restores routine log output under `bun test` (Bun sets
# NODE_ENV=test, which mutes the swarmclaw JSONL sink and cli-anything's per-run
# env diagnostics). No effect outside tests.
# (src/swarmclaw/mcp/stdio-transport.ts:34, cli-anything/src/runner.ts:44)
QDS_LOG_VERBOSE=
