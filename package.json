{
  "name": "qds-factory",
  "version": "0.1.0",
  "private": true,
  "license": "LicenseRef-QDS-Proprietary",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "pi-vs-claude-code-vendor",
    "cli-anything",
    "visualizer"
  ],
  "scripts": {
    "test": "bun test tests visualizer cli-anything --path-ignore-patterns 'pi-vs-claude-code-vendor/**'",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:visualizer": "bun run --cwd visualizer typecheck",
    "typecheck:cli-anything": "bun run --cwd cli-anything typecheck",
    "lint:visualizer": "bun run --cwd visualizer lint",
    "test:visualizer": "bun run --cwd visualizer test:coverage",
    "check:lcov": "bun run --cwd visualizer scripts/check-lcov.ts",
    "smoke:coms": "bun scripts/coms-smoke-test.ts",
    "verify:pi-lens": "bun scripts/pi-lens-verify.ts",
    "lint": "bunx @biomejs/biome check src scripts tests cli-anything pi-vs-claude-code-vendor visualizer oci",
    "build:image": "bun scripts/build-image.ts",
    "notice:sweep": "bun scripts/generate-notice.ts",
    "smoke:team": "QDS_TEAM_RUNNER=local bun cli-anything/src/index.ts run --manifest cli-anything/manifests/research-trio.yaml",
    "verify:lsp": "bun scripts/lsp-verify.ts",
    "check:roster": "bun scripts/roster-check.ts --roster config/rosters/qds-default.roster.yaml",
    "check:coverage": "bun scripts/dev/require-bun-coverage-fold.ts && bun --config=bunfig.coverage.toml test --parallel=4 tests/scripts tests/scripts/corpus tests/providers tests/lib tests/judgment tests/reverify tests/p0-9 tests/hindsight tests/qa tests/memgate tests/pr tests/kpi tests/fixloop tests/swarmclaw/mask-env.test.ts",
    "bench:lean-worker": "bun scripts/lean-worker-benchmark.ts cli-anything/manifests/lean-benchmark.yaml"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  }
}
