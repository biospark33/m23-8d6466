{
  "name": "qds-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "pi-vs-claude-code-vendor",
    "cli-anything"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "smoke:coms": "bun scripts/coms-smoke-test.ts",
    "verify:pi-lens": "bun scripts/pi-lens-verify.ts",
    "lint": "bunx @biomejs/biome check src scripts tests cli-anything pi-vs-claude-code-vendor 2>/dev/null || bunx @biomejs/biome check .",
    "smoke:team": "QDS_TEAM_RUNNER=local bun cli-anything/src/index.ts run --manifest cli-anything/manifests/research-trio.yaml",
    "verify:lsp": "bun scripts/lsp-verify.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  }
}
