#!/usr/bin/env bun
/**
 * Team-mode warren shim for runner-integration tests. Emits the NDJSON event
 * stream the P0.3 harness parses (cost / coms / worker_output / merged),
 * driven by QDS_FAKE_SCENARIO. Real `warren run pi <project> -p ...` argv is
 * accepted and ignored beyond the `run` guard.
 */
const scenario = process.env["QDS_FAKE_SCENARIO"] ?? "success";

if (process.argv[2] !== "run") {
  console.error(`warren-team-shim: unsupported subcommand '${process.argv[2]}'`);
  process.exit(64);
}

const say = (o: unknown): void => {
  console.log(JSON.stringify(o));
};
const sleep = (ms: number): Promise<void> =>
  new Promise((resolve) => setTimeout(resolve, ms));

const coms = (i: number, from: string, to: string) => ({
  type: "coms",
  request_id: `req-${i}`,
  session_id: "sess-1",
  phase_id: "dispatch_task",
  channel: `${from}:${to}`,
  direction: "send",
  sender_agent: from,
  receiver_agent: to,
  payload_size: 128,
  duration_ms: 5,
  timestamp: new Date().toISOString(),
});

const cost = (agentId: string, model: string, costUsd: number) => ({
  type: "cost",
  agentId,
  model,
  inputTokens: 100,
  outputTokens: 50,
  costUsd,
  durationMs: 800,
  timestamp: new Date().toISOString(),
});

// QDS_FAKE_SECRET_ECHO simulates a worker leaking an env secret into its
// structured reply (INV-3 artifact-redaction test).
const secretEcho = process.env["QDS_FAKE_SECRET_ECHO"];
const workerOutput = (agentId: string, changedFiles: string[] | undefined) => ({
  type: "worker_output",
  agentId,
  output: {
    ...(changedFiles !== undefined ? { changedFiles } : {}),
    result: {
      summary: `${agentId} done`,
      model: `model-of-${agentId}`,
      ...(secretEcho !== undefined ? { leaked: `token is ${secretEcho}` } : {}),
    },
  },
});

async function main(): Promise<void> {
  switch (scenario) {
    case "success": {
      say(coms(1, "lead", "worker-a"));
      say(coms(2, "worker-a", "lead"));
      say(coms(3, "lead", "worker-b"));
      say(cost("lead", "anthropic/claude-x", 0.01));
      say(cost("worker-a", "openrouter/model-a", 0.02));
      say(workerOutput("worker-a", ["src/a.ts"]));
      say(workerOutput("worker-b", ["src/b.ts", "src/a.ts"]));
      say({ type: "merged", result: { summary: "lead merged both workers" } });
      process.exit(0);
      break;
    }
    case "worker_timeout": {
      say(coms(1, "lead", "worker-a"));
      say(coms(2, "worker-a", "lead"));
      say(workerOutput("worker-a", ["src/a.ts"]));
      // worker-b never replies; lead still emits its merge and exits cleanly.
      say({ type: "merged", result: { summary: "merged without worker-b" } });
      // Give the harness's worker-b await timer time to fire before exit.
      // 1.5 s, not 300 ms: the test's coms budget has to land in the window
      // between "worker-a's output arrived" and "the child exited", and at
      // 300 ms that window was tight enough that CPU contention pushed
      // worker-a's arrival past it too, failing the run with BOTH workers
      // timed out. Widening the fixture is the fix; the assertion is unchanged.
      await sleep(1500);
      process.exit(0);
      break;
    }
    case "budget_overflow": {
      say(coms(1, "lead", "worker-a"));
      say(cost("worker-a", "openrouter/model-a", 0.2));
      say(cost("worker-b", "openrouter/model-b", 0.2));
      say(cost("lead", "anthropic/claude-x", 0.15));
      say(workerOutput("worker-a", ["src/a.ts"]));
      // Keep running: the harness must kill us (grace, then killTree).
      await sleep(60_000);
      break;
    }
    // DF1.6 T5: one cost event whose session total clears the RAISED
    // ceilings (4.5 and 9.0 USD kill thresholds) but not the un-raised 0.45
    // one — exercises effectiveCeilingMicros end to end through the budget
    // guard's real kill path.
    case "big_cost": {
      say(coms(1, "lead", "worker-a"));
      say(cost("worker-a", "openrouter/model-a", 9.5));
      say(workerOutput("worker-a", ["src/a.ts"]));
      await sleep(60_000);
      break;
    }
    // DF2.7 / INV-COST-5: same spend as budget_overflow, but the worker's
    // cost record is KNOWN-PARTIAL — some turns were never priced. The
    // cumulative total is therefore under-counted and the budget state must
    // say so.
    case "budget_overflow_unpriced": {
      say(coms(1, "lead", "worker-a"));
      say({ ...cost("worker-a", "openrouter/model-a", 0.2), turnCount: 4, unpricedTurns: 2 });
      say(cost("worker-b", "openrouter/model-b", 0.2));
      say(cost("lead", "anthropic/claude-x", 0.15));
      say(workerOutput("worker-a", ["src/a.ts"]));
      await sleep(60_000);
      break;
    }
    case "coms_init_fail": {
      say({ type: "coms_init_error", reason: "no_server_url" });
      process.exit(1);
      break;
    }
    case "lead_crash": {
      say(coms(1, "lead", "worker-a"));
      say(coms(2, "worker-a", "lead"));
      say(workerOutput("worker-a", ["src/a.ts"]));
      say(workerOutput("worker-b", ["src/b.ts"]));
      // Lead dies before emitting the merged event.
      process.exit(1);
      break;
    }
    case "logic_exit": {
      process.exit(3);
      break;
    }
    case "bad_worker_output": {
      say(coms(1, "lead", "worker-a"));
      say(coms(2, "worker-a", "lead"));
      say(workerOutput("worker-a", undefined)); // changedFiles omitted
      say(workerOutput("worker-b", ["src/b.ts"]));
      say({ type: "merged", result: { summary: "merged" } });
      process.exit(0);
      break;
    }
    case "driver_stderr": {
      // The team-lead-driver logs "worker <id> stderr tail:" diagnostics to
      // ITS stderr. Under the harness's old ["ignore","pipe","ignore"] that
      // line died at the spawn boundary — the M2.3 live round lost the fixer
      // crash line across 13 fires to exactly this discard. The line must
      // reach the harness's own stderr (journald under the in-box unit).
      console.error("worker fx-1 stderr tail: EHOSTUNREACH coms handshake failed");
      say(coms(1, "lead", "worker-a"));
      say(coms(2, "worker-a", "lead"));
      say(coms(3, "lead", "worker-b"));
      say(cost("lead", "anthropic/claude-x", 0.01));
      say(cost("worker-a", "openrouter/model-a", 0.02));
      say(workerOutput("worker-a", ["src/a.ts"]));
      say(workerOutput("worker-b", ["src/b.ts", "src/a.ts"]));
      say({ type: "merged", result: { summary: "lead merged both workers" } });
      process.exit(0);
      break;
    }
    case "hang": {
      await sleep(60_000);
      break;
    }
    case "oversized_multibyte_line": {
      // F15 regression: a legitimate preamble of small NDJSON lines, then ONE
      // line whose raw byte length (multibyte UTF-8) exceeds the cap but whose
      // UTF-16 unit length does NOT — exercises raw-byte counting + per-line
      // discard + resume. The trailing `merged` MUST still parse.
      say(coms(1, "lead", "worker-a"));
      say(coms(2, "worker-a", "lead"));
      say(cost("worker-a", "openrouter/model-a", 0.01));
      say(workerOutput("worker-a", ["src/a.ts"]));
      say(workerOutput("worker-b", ["src/b.ts"]));
      // "あ" is 3 UTF-8 bytes but 1 UTF-16 unit: 1000 of them = 3000 bytes,
      // 1000 units — under a 2048-byte cap by units, over it by bytes. No
      // newline until past the cap, then terminate the oversized line.
      process.stdout.write("あ".repeat(1000));
      process.stdout.write("\n");
      say({ type: "merged", result: { summary: "resumed after oversized line" } });
      process.exit(0);
      break;
    }
    case "split_multibyte_at_cap": {
      // F15 decoder-reset regression: unlike oversized_multibyte_line (whole
      // chars), this splits ONE 3-byte char ("あ" = E3 81 82) across the chunk
      // boundary that ALSO breaches the byte cap, so the decoder is holding a
      // partial char when the line is discarded. If the discard path fails to
      // reset the decoder, those stale bytes flush as a U+FFFD prefix onto the
      // trailing `merged` line, JSON.parse fails, and the run misclassifies.
      // sleeps force each write() into its own reader `data` event so the split
      // is deterministic rather than dependent on pipe coalescing.
      say(coms(1, "lead", "worker-a"));
      say(coms(2, "worker-a", "lead"));
      say(cost("worker-a", "openrouter/model-a", 0.01));
      say(workerOutput("worker-a", ["src/a.ts"]));
      say(workerOutput("worker-b", ["src/b.ts"]));
      await sleep(50); // let the preamble drain as its own chunk(s)
      // Chunk A: 679×"あ" (2037 B) + the FIRST byte of a 680th "あ" = 2038 B.
      // Under a 2048-byte cap, so it is accepted and the decoder buffers the
      // lone lead byte (accepted prefix ends at an odd UTF-8 offset).
      const chunkA = Buffer.concat([
        Buffer.from("あ".repeat(679), "utf8"),
        Buffer.from([0xe3]),
      ]);
      process.stdout.write(chunkA);
      await sleep(50);
      // Chunk B: the 2 continuation bytes that complete the split char, filler,
      // then the newline. 2038 + 23 = 2061 > 2048 → the line is discarded and
      // the decoder MUST be reset before parsing resumes.
      const chunkB = Buffer.concat([
        Buffer.from([0x81, 0x82]),
        Buffer.from("x".repeat(20), "utf8"),
        Buffer.from("\n", "utf8"),
      ]);
      process.stdout.write(chunkB);
      await sleep(50);
      say({ type: "merged", result: { summary: "resumed after split multibyte line" } });
      process.exit(0);
      break;
    }
    case "many_small_lines_one_chunk": {
      // F15 per-LINE cap regression: several complete NDJSON lines coalesced
      // into a SINGLE write, whose SUM exceeds the cap but where NO line does.
      // A chunk-level cap check would drop the first line (and log a false
      // breach); the per-line scan must keep every line. Padded worker
      // summaries (~800 B each) push the total past the 2048-byte test cap.
      const lines = [
        coms(1, "lead", "worker-a"),
        coms(2, "worker-a", "lead"),
        { ...workerOutput("worker-a", ["src/a.ts"]), output: { changedFiles: ["src/a.ts"], result: { summary: `worker-a done ${"x".repeat(700)}` } } },
        { ...workerOutput("worker-b", ["src/b.ts"]), output: { changedFiles: ["src/b.ts"], result: { summary: `worker-b done ${"x".repeat(700)}` } } },
        { type: "merged", result: { summary: "all small lines survived one chunk" } },
      ];
      process.stdout.write(lines.map((l) => JSON.stringify(l)).join("\n") + "\n");
      process.exit(0);
      break;
    }
    case "partial_output_over_cap": {
      // DF1.6 T1/R9 regression: emit >10KB of valid NDJSON, then die without
      // a merged event. partialOutput must come back capped at
      // MAX_PARTIAL_OUTPUT_CHARS AND end with the shared truncation marker —
      // silently-clipped output (no marker) is the bug this guards against.
      for (let i = 0; i < 20; i++) {
        say({ ...coms(i + 1, "lead", "worker-a"), channel: `lead:worker-a:${"p".repeat(700)}` });
      }
      process.exit(1);
      break;
    }
    case "abort_graceful_exit0": {
      // R12 regression: emits the full success stream, then idles. On SIGTERM
      // (the abort kill) it emits merged and exits 0 — a child honoring the
      // abort kill cleanly. The runner must still classify the run transient,
      // not success.
      say(coms(1, "lead", "worker-a"));
      say(coms(2, "worker-a", "lead"));
      say(workerOutput("worker-a", ["src/a.ts"]));
      say(workerOutput("worker-b", ["src/b.ts"]));
      process.on("SIGTERM", () => {
        say({ type: "merged", result: { summary: "graceful shutdown" } });
        process.exit(0);
      });
      await sleep(60_000);
      break;
    }
    case "watchdog_kill": {
      // Stay alive for watchdog to escalate. Emit a cost event first to match
      // production pattern and let budget-vs-watchdog races surface.
      say(cost("lead", "anthropic/claude-x", 0.01));
      await sleep(60_000);
      break;
    }
    // T10: emit a cost read from QDS_FAKE_THRESHOLD_COST so the test derives
    // the exact kill threshold from budgetKillThresholdUsd() in runner.ts —
    // one source of truth for the 0.9 kill fraction instead of a hardcoded
    // 0.45 that silently stops being the boundary if the fraction changes.
    case "threshold_exact": {
      const exactCostUsd = Number(process.env["QDS_FAKE_THRESHOLD_COST"] ?? "0.45");
      say(coms(1, "lead", "worker-a"));
      say(cost("lead", "anthropic/claude-x", exactCostUsd));
      say(workerOutput("worker-a", ["src/a.ts"]));
      await sleep(60_000);
      break;
    }
    // T11 boundary: ONE line of exactly QDS_FAKE_LINE_BYTES raw bytes
    // (trailing newline included), driven by env so the test can probe the
    // cap's exact edge (kept at N == cap, dropped at N == cap + 1). The
    // line's content is parse-rejected noise — only its byte length matters.
    case "cap_boundary_line": {
      const lineBytes = Number(process.env["QDS_FAKE_LINE_BYTES"] ?? "2048");
      say(coms(1, "lead", "worker-a"));
      say(coms(2, "worker-a", "lead"));
      say(workerOutput("worker-a", ["src/a.ts"]));
      say(workerOutput("worker-b", ["src/b.ts"]));
      await sleep(50); // own data event, so the line is judged alone
      process.stdout.write("x".repeat(lineBytes - 1) + "\n");
      await sleep(50);
      say({ type: "merged", result: { summary: "boundary line processed" } });
      process.exit(0);
      break;
    }
    default: {
      console.error(`warren-team-shim: unknown scenario '${scenario}'`);
      process.exit(70);
    }
  }
}

await main();
