# Z4 (authored) — hindsight-qds.env.example — TEMPLATE ONLY, COMMITTED, SECRET-FREE.
#
# The REAL file is operator-placed beside docker-compose.factory.yml as
# `hindsight-qds.env`, mode 0600, operator-held credentials (runbook G3) —
# never by automation, never committed. Copy this template, fill values, chmod 600.
#
# NAMES ONLY here — every value below is an obvious placeholder. A literal
# credential in any committed template fails tests/deploy/vps-profile.test.ts.
#
# Provider/model/reranker pins are NOT set here: the committed `environment:`
# block in docker-compose.factory.yml owns them and BEATS env_file per compose
# precedence (runbook §0: "do not 'fix' provider/reranker pins in hindsight.env").

# The Hindsight tenant API key this dedicated instance requires.
HINDSIGHT_API_TENANT_API_KEY=<placeholder>

# The LLM provider key (OpenRouter; see the committed environment: pins).
HINDSIGHT_API_LLM_API_KEY=<placeholder>

# Host-side origin of the dedicated factory instance: the SINGLE loopback
# publish 127.0.0.1:18890:8888 (docker-compose.factory.yml). Port is 18890,
# NEVER 18889 — on a both-stacks box 18889 is the platform tenant stack's
# map and an on-box 18889 reach resolves the WRONG (tenant) instance
# (runbook Z4 annotation; R2 trap #7 / DD-28.22 adjudication).
# M1.1's host legs (provisioner + smoke, runbook §6.4) read HINDSIGHT_BASE_URL
# by this name. Their Hindsight client (src/hindsight/client.ts) still carries
# DEFAULT_BASE_URL=http://127.0.0.1:8888 for the UNSET case — so leaving the
# variable unset silently selects the WRONG (tenant/shared-sidecar) instance.
# Always set the variable; nothing may rely on the default.
HINDSIGHT_BASE_URL=http://127.0.0.1:18890
