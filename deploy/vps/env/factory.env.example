# Z4 (authored) — factory.env.example — TEMPLATE ONLY, COMMITTED, SECRET-FREE.
#
# This file is the compose project .env reference: copy to the host compose
# project directory as `.env`. The TEMPLATE stays committed at 0644; the REAL
# files (this one and hindsight-qds.env) are operator-placed, mode 0600,
# operator-held credentials (runbook G3) — never by automation, never
# committed. A literal credential in any committed template fails
# tests/deploy/vps-profile.test.ts.
#
# `SOLSTICE_TENANT_ID` is deliberately ABSENT: it stays the swarmclaw stack's
# .env.local item (runbook G3/G6 fence — that stack refuses boot without the
# tenant pin). It is named here as annotation only and must never appear as a
# key in any deploy/vps/ template.

# ── Seeded-once compose interpolation variables ─────────────────────────────
# OPERATOR-SEEDED ONCE; redeploys NEVER rewrite these (FORK_IMAGE_TAG
# precedent — docker-compose.factory.yml header). F-006, the true fail-late
# stage: unseeded, compose v2 WARNS and interpolates EMPTY (no config-time
# refusal); the invalid `ghcr.io//qds-m2-gateway:` ref FAILS AT PULL TIME.

# GHCR owner for the factory images (the qds-m2-gateway repo path).
# MUST be lowercase: GHCR/OCI repo paths are lowercase, and a mixed-case
# GitHub org name renders an invalid ghcr ref.
QDS_FACTORY_OWNER=

# Tag of the published qds-m2-gateway image. Before M2.1's image is
# published this service cannot come up; smoke evidence records
# {"status":"awaiting-image"} — an EVIDENCE-FILE CONVENTION, not a compose
# state (docker compose ps shows no m2-gateway row pre-image). Never
# green-by-default.
M2_GATEWAY_TAG=

# Name of the EXISTING control-plane compose network — the one front door
# this stack JOINs (external: true; creates nothing). Verify on the box:
#   docker network ls
FACTORY_FRONT_DOOR_NETWORK=control-plane_default

# Compose interpolates SOLSTICE_MODEL_MEMORY_EXTRACTION for the committed
# hindsight model pin (HINDSIGHT_API_LLM_MODEL in docker-compose.factory.yml).
# Interpolation precedence is SHELL FIRST, project .env SECOND: a SOLSTICE_*
# var exported in the operator shell silently retargets the story-normative
# pin EVEN IF it is seeded here — seeding this .env pins nothing against an
# exported shell var. The honest pins are: never export the var (unset =
# the committed default google/gemini-3.7-flash), or accept that an export
# wins.
# SOLSTICE_MODEL_MEMORY_EXTRACTION=

# ── Factory CLI / host legs ─────────────────────────────────────────────────
# BOUNDARY WARNING (runbook sourcing rule): these NAMES also live in the
# factory checkout `.env` — which must take the HOST-side origin
# http://127.0.0.1:18890, NEVER this file's compose-side value below (it is
# unresolvable outside the compose network). One directory-swap is the
# wrong-instance trap; never copy this file's copy of these keys into the
# checkout `.env`.
# Compose-side and container consumers address the DEDICATED instance by its
# compose-network service name (m2-gateway is the first such consumer). This
# is NEVER the runbook §6.3 shared-sidecar value http://127.0.0.1:8888 — that
# resolves the TENANT instance (R2 trap #7). Host-side legs use
# http://127.0.0.1:18890 instead (see env/hindsight-qds.env.example).
HINDSIGHT_BASE_URL=http://hindsight-qds:8888

# Bearer credential names for the factory CLI's Hindsight calls (values are
# operator-held; placeholders only here).
HINDSIGHT_BEARER_TOKEN=<placeholder>
HINDSIGHT_API_KEY=<placeholder>

# SwarmClaw fork command/command-arg/env allowlists, as in the repo root
# .env.example (comma-separated; empty values take the code defaults).
SWARMCLAW_COMMAND_ALLOWLIST=
SWARMCLAW_NPX_PACKAGE_ALLOWLIST=
SWARMCLAW_ARG_POLICY=
SWARMCLAW_ENV_ALLOWLIST=

# Fleet run records directory (scripts/fleet.ts state root).
QDS_RUNS_DIR=
