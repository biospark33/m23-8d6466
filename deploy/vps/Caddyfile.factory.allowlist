# Z4 (authored) — Caddy ALLOWLIST FRAGMENT for the factory M2 gateway.
#
# This is a FRAGMENT, not a deployment. There is NO second Caddy, NO second
# listener, NO second TLS stack (Z4 AC7 / charter §2.2): the OPERATOR splices
# the host block below into the EXISTING control-plane Caddyfile (the
# vultr-deploy template's deploy/control-plane/Caddyfile — the box's one
# front door, already terminating TLS on 443 and serving ACME over 80) on
# VPS day, then reloads:
#   caddy reload --config /etc/caddy/Caddyfile   (or the host's reload path)
# Never install this file as a standalone Caddyfile; never run a second
# Caddy container. The firewall stays runbook §1's 22/80/443-only.
#
# Replace <factory.example.com> with the real, DNS-resolvable hostname
# BEFORE splicing. ACME issuance/renewal is the existing front door's
# HTTP-01 over port 80 — unchanged; this fragment adds no listener.
#
# Idiom (copied verbatim from the template's E09-GAP-01b/01c/01d
# ops-token-gated precedent): named matchers `@name { method …, path … }` +
# `handle @name { reverse_proxy … }`, ending in the terminal default-404
# `handle { respond 404 }`. This route table is NOT exhaustive of the
# gateway's surface by design; THAT IS THE POINT — everything not listed is
# 404, not forwarded.
#
# Upstream is the compose-network service name m2-gateway:8080 (the gateway
# publishes NO host ports; see docker-compose.factory.yml). M2.1 WIDENS the
# row set in this same idiom — authz internals (recall-only keys,
# revoke-verify) are M2.1's; this fragment authors the slot's perimeter only.
# NO row may ever forward to a hindsight service (hindsight-qds:8888 /
# 127.0.0.1:18890) — the perimeter reaches the gateway only (INV-Z4-1).

<factory.example.com> {
	# AC3: the memory gateway's recall surface — the single allowlisted row.
	@recall {
		method POST
		path /v1/recall
	}
	handle @recall {
		reverse_proxy m2-gateway:8080
	}

	# AC3: everything else — including any hindsight path (/v1/memories,
	# /v1/banks, …) and the gateway's own health surface — is not routed:
	# 404, not forwarded. Health is probed inside the compose network, never
	# through this front door.
	handle {
		respond 404
	}
}
