node_modules/
.gitnexus/
ruvector.db
.swarm/
*.log
.DS_Store
bun.lockb

# DF2.9: image build scratch — the generated NOTICE, the sweep summary and the
# per-stage .iid files are outputs of `bun run build:image`, regenerated every
# run. The committed evidence copy lives under _bmad-output/sprint-artifacts/.
oci/.build/
.env
.env.local

# P0.10: a SIGKILL/OOM during `gitnexus analyze` can leak the transient root
# .gitnexusignore (traps don't run on SIGKILL). Ignore it so the leak surfaces
# as ignored, not as an untracked file polluting `git status`.
/.gitnexusignore

# DF2.1: host run records + fake-driver boxes are per-run scratch, never committed.
.sandbox/

# F100: `artifacts/` is a MIXED sink — df1-3-e2e-event-stream.json is tracked
# evidence. The worker captures are scratch (cli-anything/src/runner.ts now
# defaults to .sandbox/artifacts, but an explicit --artifacts-dir or an older
# checkout can still land them here). Ignore the scratch by name, so the tracked
# evidence beside it stays visible in `git status`.
/artifacts/worker-*.json

# DF4.2: outputs of the visualizer coverage gate and the component build gate.
# `bun run --cwd visualizer test:coverage` writes coverage/lcov.info (the file
# scripts/check-lcov.ts parses in the next CI step) and `build:check` writes
# dist/. Both are regenerated every run; the committed evidence copy lives
# under _bmad-output/evidence/df4-2/.
visualizer/coverage/
visualizer/dist/

# qds-pr-monitor transient state
.claude/state/

# F092: the analyze serialization lock (scripts/install-gitnexus-plus.sh).
# Same reasoning as /.gitnexusignore above — a SIGKILLed run can leak it, and it
# should surface as ignored scratch, not as an untracked directory.
/.gitnexus-analyze.lock/
# ...and the transient `.stale.<pid>` name a reclaim renames a dead holder's
# lock to before removing it.
/.gitnexus-analyze.lock.stale.*

# Scratch directories written by qds-pr-monitor agents inside per-PR worktrees
# (poll helper scripts, per-monitor working notes). Untracked and un-ignored,
# they were one `git add -A` away from landing in an unrelated PR.
.qds-mon/
.pollscripts/

# ── Round-cleanup, 2026-09-03 ────────────────────────────────────────────────
# Runtime cost ledgers written at the REPO ROOT. The real default is
# `.sandbox/cost-ledger.db` (DEFAULT_COST_LEDGER_FILE), so a root-level one is
# always pollution — a run with a bad cwd or an explicit QDS_COST_LEDGER_FILE.
# Same family as issue #138's sandbox pollution.
/cost-ledger.db
/cost-ledger.db-shm
/cost-ledger.db-wal

# Scratch `git bundle`s. One sat here at 8.6 MB holding a ref the repo already
# contained, i.e. 8.6 MB that proved nothing.
/repo.bundle

# Benchmark output. `/artifacts/` is a MIXED sink (see F100 above) — the tracked
# `df1-3-e2e-event-stream.json` stays tracked; only generated benchmarks are
# ignored.
/artifacts/*-benchmark.json

# Raw PR diffs and branch patches under workflow-state. These are REGENERABLE
# (`gh pr diff <n>`) and they dominate the tree: 134 of them were 15 MB against
# 1.1 MB for the 143 reviewer reports beside them. The convention this encodes
# is the one the repo already follows — archive the REPORTS, not the diffs.
# The handful of diffs deliberately committed before this rule stay tracked
# (.gitignore never untracks), and `git add -f` still works for a new one.
_bmad-output/workflow-state/**/*.diff
_bmad-output/workflow-state/**/*.patch

# Machine-local Claude Code permission allowlist: full of one-off `ssh exe.dev`
# commands naming specific short-lived VMs from past live rounds. Local noise,
# not shared config.
/.claude/settings.json

# DF5.3 D9: the live E2E round's audit-link store. `liveAuditStorePath()`
# (tests/fleet/e2e/live-harness.ts) puts it beside the round's evidence, where
# this repo DOES track `.db` files — and `openAuditStore` appends, so round N+1
# piles onto round N in the same file forever. Per-`runId` reads stay correct;
# the growing opaque binary offered for commit does not. Per-round naming is
# deferred (it would split a resumed round's links across files).
_bmad-output/evidence/**/audit-links.db
_bmad-output/evidence/**/fire.env

# operator-local factory config (repos/approvers allowlists, 0600) + local demo byproducts
.factory/

# Z4 operator-placed env files (runbook G3: 0600, never committed)
deploy/vps/*.env
