node_modules/
.gitnexus/
ruvector.db
.swarm/
*.log
.DS_Store
bun.lockb

# DF2.9: image build scratch — the generated NOTICE, the sweep summary and the
# per-stage .iid files are outputs of `bun run build:image`, regenerated every
# run. The committed evidence copy lives under _bmad-output/sprint-artifacts/.
oci/.build/
.env
.env.local

# P0.10: a SIGKILL/OOM during `gitnexus analyze` can leak the transient root
# .gitnexusignore (traps don't run on SIGKILL). Ignore it so the leak surfaces
# as ignored, not as an untracked file polluting `git status`.
/.gitnexusignore

# DF2.1: host run records + fake-driver boxes are per-run scratch, never committed.
.sandbox/

# F100: `artifacts/` is a MIXED sink — df1-3-e2e-event-stream.json is tracked
# evidence. The worker captures are scratch (cli-anything/src/runner.ts now
# defaults to .sandbox/artifacts, but an explicit --artifacts-dir or an older
# checkout can still land them here). Ignore the scratch by name, so the tracked
# evidence beside it stays visible in `git status`.
/artifacts/worker-*.json

# DF4.2: outputs of the visualizer coverage gate and the component build gate.
# `bun run --cwd visualizer test:coverage` writes coverage/lcov.info (the file
# scripts/check-lcov.ts parses in the next CI step) and `build:check` writes
# dist/. Both are regenerated every run; the committed evidence copy lives
# under _bmad-output/evidence/df4-2/.
visualizer/coverage/
visualizer/dist/

# qds-pr-monitor transient state
.claude/state/

# F092: the analyze serialization lock (scripts/install-gitnexus-plus.sh).
# Same reasoning as /.gitnexusignore above — a SIGKILLed run can leak it, and it
# should surface as ignored scratch, not as an untracked directory.
/.gitnexus-analyze.lock/
# ...and the transient `.stale.<pid>` name a reclaim renames a dead holder's
# lock to before removing it.
/.gitnexus-analyze.lock.stale.*

# Scratch directories written by qds-pr-monitor agents inside per-PR worktrees
# (poll helper scripts, per-monitor working notes). Untracked and un-ignored,
# they were one `git add -A` away from landing in an unrelated PR.
.qds-mon/
.pollscripts/
