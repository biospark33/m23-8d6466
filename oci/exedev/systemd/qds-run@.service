# QDS-Factory in-box phase-engine run, one instance per runId (story DF2.10).
#
# Baked into the image at /etc/systemd/system/qds-run@.service. NOT enabled and
# NOT started by DF2.10 — this story ships the file and its policy, nothing
# more. `fleet run <run-id>` (DF1.10) starts `qds-run@<runId>.service`.

[Unit]
Description=QDS-Factory phase-engine run %i

# The steering channel /run/steering is created by
# /etc/tmpfiles.d/qds-steering.conf, which systemd-tmpfiles-setup.service
# applies at boot. Ordering after it means the engine never races the channel
# it writes into. /run is tmpfs, so this is a real dependency on every boot,
# not just the first.
#
# BOTH directives, because they say different things. `After=` is ORDERING
# ONLY: it is satisfied vacuously when the named unit never ran or ran and
# FAILED. Default dependencies cover the ordinary boot, which is why this was
# survivable — but a malformed conf dropped into /etc/tmpfiles.d/ by any later
# story fails systemd-tmpfiles-setup while sysinit.target still activates, and
# the engine would then start against a /run with no steering directory,
# defeating the tmpfiles entry that exists so DF1.11's re-provision converges on
# exact bytes. `Requires=` makes the dependency the one systemd enforces: the
# engine does not start at all if the channel's creator failed.
#
# CEILING, stated because `Requires=` is not only a refusal: it is also a
# PULL-IN. At a late start with the oneshot inactive, systemd ACTIVATES
# systemd-tmpfiles-setup.service, which re-applies every config in
# /etc/tmpfiles.d/ mid-run rather than refusing. That is why the assertion
# below exists: the property the engine actually needs is "the channel is
# there", and `AssertPathIsDirectory=` states it directly, fails the start job
# with a named message, and does not depend on the oneshot's state at all.
After=systemd-tmpfiles-setup.service
Requires=systemd-tmpfiles-setup.service

# `EnvironmentFile=` below is mandatory-form (no leading `-`) on purpose: a
# missing credential file must refuse the unit, never start an engine with no
# key. Right direction, illegible failure — a race against DF2.3's delivery
# surfaced as a generic exec-class error naming nothing, and the no-restart
# policy below makes it terminal, so the one shot at diagnosis is what
# `systemctl status` prints.
# ASSERT, not Condition: a failed `Condition…=` marks the unit SKIPPED and the
# start job SUCCEEDS (exit 0), which would turn a loud failure into a silent
# no-op for whatever ran `systemctl start`. A failed `Assert…=` fails the job
# and logs "Assertion failed for …" with the path. Fail-safe option taken.
# This does not weaken the refusal: the mandatory EnvironmentFile= is still what
# refuses a file that exists and cannot be read.
AssertPathExists=/home/exedev/app/.env
# The steering channel itself, asserted rather than inferred from the ordering
# above: `After=` is vacuous when the oneshot never ran, and `Requires=` reacts
# to the UNIT's state, not to the directory's. Same Assert-not-Condition
# reasoning as the line above — a failed assertion fails the job and logs
# "Assertion failed for …" naming this path, where a `Condition…=` would mark
# the unit skipped and report success to whoever ran `systemctl start`.
AssertPathIsDirectory=/run/steering

[Service]
Type=simple
User=exedev

# cwd STATED, not inherited. With no WorkingDirectory= the engine runs in the
# manager's cwd (`/`), which this file would then be silent about — and the
# image sets no WORKDIR on purpose (re-declaring one is boot-contract risk), so
# nothing else states it either. `/` is the value that changes nothing today
# and is not writable by `User=`, so a relative-path write fails loudly instead
# of landing somewhere nobody chose. DF1.10 may move it to the run root it
# resolves; moving it is then a visible diff.
WorkingDirectory=/

# PRIVILEGE POLICY. This unit runs AGENT-AUTHORED code as the box's login user
# — the pi/engine process executes whatever the model wrote. The file reasoned
# about restart, stop and install policy and was silent here, which read as
# "considered and declined" rather than "not considered".
#   NoNewPrivileges= closes setuid/setgid escalation out of that process and
#     everything it spawns, for free.
#   PrivateTmp= gives each qds-run@<runId> instance its own /tmp and /var/tmp,
#     so concurrent instances — which the template form exists for — cannot
#     read or clobber each other's scratch files.
#   UMask= makes run artefacts 0600/0700 rather than world-readable 0644.
#
# OPERATOR DECISIONS on the two costs these directives carry, recorded where
# the next reader looks (#217's Hold items, decided at the re-pin):
#   F-D3 — the NoNewPrivileges directive makes `sudo` inert for the whole
#     process tree, so a `code` phase cannot `sudo apt-get install …`. KEPT:
#     this unit runs agent-authored code, and the privilege boundary around
#     that is the directive's entire purpose. A phase that genuinely needs a
#     system change is a manifest/roster problem to solve above the unit,
#     never a reason to hand a model-authored tree setuid.
#   F-D2 — the PrivateTmp directive gives each instance a private /tmp, so an
#     operator
#     debugging over ssh cannot see the run's /tmp, and TMPDIR-bearing child
#     writes vanish at unit stop. KEPT: harvest was verified unaffected (none
#     of its three source sets contains a /tmp path), concurrent instances
#     cannot clobber each other's scratch, and the run's durable evidence
#     (journal, engine log, marker, trace) lives outside /tmp by INV-IBOX-8 —
#     /tmp debuggability was never part of the evidence contract.
# DELIBERATELY NOT ProtectSystem=strict: it makes the whole filesystem
# read-only, so it needs an explicit ReadWritePaths= for the run root and
# /run/steering — and the run root is DF1.10's to name (INV-IBOX-13 has the
# engine resolve it, so this file cannot know it). Adding the directive without
# those paths would turn every run into a read-only-filesystem failure. It is
# the next hardening step once DF1.10's ExecStart lands, not a value to guess.
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

# DF3.6b — CGROUP DELEGATION, and it is load-bearing, not hardening decoration.
# The resident agent's memory bound is enforced by the KERNEL (`memory.max` on a
# per-solicitation child cgroup rooted at pi's own pid), never sampled by the
# engine. Creating that child cgroup and writing its `memory.max` requires the
# unit's cgroup directory, `cgroup.procs` and `cgroup.subtree_control` to be
# writable by `User=exedev` — which is exactly what `Delegate=` does, and it is
# the ONLY mechanism that does it without root, without D-Bus and without
# polkit. (`systemd-run --scope` needs the system manager over D-Bus, which a
# `User=exedev` process inside a system unit cannot reach non-interactively.)
#
# SCOPED to `memory` on purpose: a bare `Delegate=yes` hands over every
# controller the manager has, which is a far wider grant than one memory bound
# needs. The engine enables `+memory` in its own subtree after moving itself
# into a `supervisor/` leaf (cgroup v2's no-internal-processes rule).
#
# Absent this directive the resident is NOT STARTED (DF3.6b AC3 / INV-MEM-2):
# the engine never runs an agent whose memory it cannot bound. That is why the
# Dockerfile's unit scan asserts it POSITIVELY — a later edit that drops this
# line does not fail loudly at boot, it silently disables the resident on every
# run, and the image is where that regression has to be caught.
Delegate=memory

# THE ENGINE'S RUNTIME DIRECTORIES, and this unit is where they belong.
#
# MEASURED FAILURE, first live in-box round (2026-09-04): the engine died at
# startup with
#     pipeline-run: EACCES: permission denied, mkdir '/run/trace'
# `ActiveState=failed Result=exit-code ExecMainStatus=2`. `/run` is root-owned
# tmpfs and this unit runs as `User=exedev`, so the engine cannot create its own
# directories there. It needs two: `runMarkerPath(<runId>)` is
# `/run/qds-run/<runId>/journal/final.json` and the trace store is
# `/run/qds-run/<runId>/trace/trace.db` (both on tmpfs deliberately —
# INV-IBOX-8 puts only the durable artefacts in $HOME).
#
# PER-INSTANCE SINCE #217 F-D1 (image half): the template unit used LITERALS
# (both directories at the top of /run), so every instance shared one journal
# tree and Preserve=yes carried run A's terminal marker into run
# B's tmpfs — the image-side amplifier of the marker-identity defect DF1.10
# round 1 closed in TypeScript. The directories are now keyed by `%i`, the
# instance name, which is the runId: two units can no longer share a root by
# construction. The engine derives the same tree from its sole argv
# (`runMarkerRoot(runId)` in journal.ts) — no QDS_* path variable bridges them,
# because INV-IBOX-13 (DF1.11) and AC4 (DF3.7) forbid the unit from naming the
# run root and the AC6 scan enforces that. %i in RuntimeDirectory is specifier
# expansion systemd performs on the directive (same mechanism as ExecStart's
# %i), and nested components are created with the leaf owned by `User=`.
#
# `RuntimeDirectory=` rather than a tmpfiles entry, and the split is deliberate.
# /etc/tmpfiles.d/qds-steering.conf provisions the STEERING channel because that
# channel must exist at BOOT, before and independently of any run (#180: /run is
# tmpfs and a reboot wipes it). These two are different: they are needed only
# while a run is executing, systemd creates them owned by `User=` at unit start,
# and DF2.10's AC6 contract pins qds-steering.conf as ONE line whose five copies
# agree — bolting an unrelated concern onto it would break that agreement to
# save a directive.
#
# NO COLLISION, verified against the shipped image rather than assumed: nothing
# in /usr/lib/tmpfiles.d or /etc/tmpfiles.d claims /run/qds-run or anything
# beneath it, and journald's runtime store is /run/log/journal (`z
# /run/log/journal 2755 root systemd-journal`), not /run/qds-run.
#
# PRESERVE=yes IS LOAD-BEARING. systemd removes a RuntimeDirectory when the unit
# stops; the terminal marker must OUTLIVE the engine, because `fleet status`
# (AC5) and harvest (AC4) both read it after the run has settled. Without this
# the marker would be deleted at the exact moment it becomes the thing the host
# is waiting for. CEILING of the per-instance form, stated: each settled run
# leaves one preserved tree behind, so a long-lived box accumulates one small
# tree per run (marker + trace). Teardown destroys the box, and a reboot wipes
# tmpfs — nothing sweeps mid-life, deliberately: a sweep here would be the unit
# deleting the very evidence Preserve=yes exists to keep.
#
# 0700, matching the steering channel: run artefacts are not world-readable, and
# `UMask=0077` above says the same thing about the files inside them.
RuntimeDirectory=qds-run/%i/journal qds-run/%i/trace
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# LOAD-BEARING (DF2.10 AC6). A restarted engine re-walks phases whose git
# commits and LLM spend already happened — it cannot know which of them
# completed, because the crash is what destroyed that knowledge. Restarting is
# therefore double-spend and double-commit, not recovery. `Restart=on-failure`
# would pass a naive "the engine comes back" test and MUST fail this one.
# Reclaim after a restart is DF1.10's scope, and it is a deliberate host-side
# decision, never an automatic systemd one.
Restart=no

# STOP is as load-bearing as restart, and the manager default is not safe for
# this workload. With no TimeoutStopSec= a `Type=simple` unit takes the manager
# default (90 s), after which systemd SIGKILLs the whole control group — so a
# routine `systemctl stop qds-run@<runId>` during teardown or a reap, not some
# exotic path, can kill a phase engine mid-`git push` or mid-model-call and
# destroy exactly the knowledge the Restart=no argument above says a crash
# destroys. 300 s is sized to the two operations that must never be cut in
# half: one repo-sized push and one in-flight model completion. It is bounded
# rather than `infinity` on purpose — an engine that ignores SIGTERM must cost a
# teardown five minutes, not wedge the reaper forever.
TimeoutStopSec=300

# KILL POLICY (#186 item 5's other half; `TimeoutStopSec` above was its first).
# The manager default is `KillMode=control-group`, which sends the stop signal
# to EVERY process in the cgroup at once — and this engine's cgroup contains
# processes it spawned and is responsible for winding down: a pi child holding
# an in-flight model completion, a `code` phase mid-`git push`, a team-lead
# driver. Signalling those directly is the same mid-operation truncation the
# `TimeoutStopSec` paragraph above exists to prevent, arriving one directive
# earlier. `mixed` sends SIGTERM to the MAIN process only, so the engine gets
# the 300 s window to stop its own children in an order it understands (it
# already owns a process-tree killer for exactly this), and systemd's final
# SIGKILL still covers the whole cgroup so nothing survives the stop.
# `KillSignal=` is stated rather than inherited for the same reason
# `TimeoutStopSec=` is: SIGTERM is the default today, and a moved manager
# default must not silently change what a phase engine is asked to do.
KillMode=mixed
KillSignal=SIGTERM

# NO TimeoutStartSec=, and its absence is the honest state. It used to be here
# at 60 s, described as bounding a wedged exec — it cannot. For `Type=simple`
# systemd considers the unit STARTED as soon as the process is forked, so the
# start window closes microseconds after activation and the timeout can never
# elapse; a genuinely wedged `execve` fails immediately with an exec error, not
# a timeout. The directive protected nothing while reading to the next
# maintainer as an activation safety net that had been considered and covered.
# Arming it means `Type=notify` or `Type=exec`, and the service type belongs to
# DF1.10 along with the ExecStart it describes — so this is a deleted lie, not
# a traded-away guard.

# The LITERAL path, deliberately not `%h/app/.env`. In a *system* unit `%h`
# expands to the home of the service MANAGER (root -> /root), not to the home
# of `User=`. The per-run capped LLM key is delivered by DF2.3 to
# /home/exedev/app/.env at 0600; `%h` here would silently read /root/app/.env,
# find nothing, and start the engine with no credential.
EnvironmentFile=/home/exedev/app/.env

# TWO Environment= lines, and DF2.10's AC6 had to be NARROWED to admit them —
# so the narrowing is argued here rather than performed quietly in the
# Dockerfile. AC6 as written forbade every QDS_* variable this image can hand a
# booted box. What INV-IBOX-13 (DF1.11) and AC4 (DF3.7) actually rest on is
# narrower and is UNCHANGED: the engine resolves its own RUN ROOT and STEERING
# ROOT rather than inheriting them, so QDS_RUN_ROOT and QDS_STEERING_ROOT stay
# forbidden — and `runMarkerRoot()` returning /run in the box depends on
# QDS_RUN_ROOT being unset, which the build-time scan still enforces.
#
# The two below are a different kind of fact. They describe THIS IMAGE'S OWN
# LAYOUT, which is the one thing only the image can know:
#   QDS_PI_CATALOG_DIR — pi ships here as a compiled ELF with no sibling
#     node_modules, so `findBundledCatalogDir()` (src/phase-engine/roster/
#     validate.ts) cannot locate the catalog by walking up from `pi`, and
#     `loadBundledCatalog` throws a RateError that DISABLES the resident and
#     refuses every dispatch_task phase. The engine cannot resolve this one
#     itself: where the catalog was staged is a property of the build, not of
#     the run. Leaving it unset does not degrade — it refuses.
#   QDS_TEAM_RUNNER=local — unset makes dispatch_task refuse. There is no
#     warren server on a factory box and there is no run-dependent alternative;
#     `local` is a property of the substrate, decided by the substrate.
# The Dockerfile's AC6 scan allow-lists exactly these two BY NAME, so a third
# QDS_* variable added to this file still fails the build.
Environment=QDS_PI_CATALOG_DIR=/usr/local/share/qds/pi-catalog
Environment=QDS_TEAM_RUNNER=local

# THE ENGINE. `%i` is the runId and the ONLY argument: DF1.10's engine derives
# run root, manifest, witness and marker path from it in-box, so every other
# flag would be a second place for those to be decided.
#
# `%i` IS QUOTED — belt-and-braces (#186 item 6, corrected at the #217 re-pin).
# The LOAD-BEARING property is not the quoting: it is that the unit uses `%i`,
# the instance name AS-TYPED, and never `%I`. systemd's unit-name grammar
# admits no whitespace, so `%i` cannot expand to a string containing a space —
# the old rationale described `%I`, the C-unescaped form, which maps `-` back
# to `/`; every id `newId` mints is `<slug>-<YYYYMMDD>-<6 hex>`, so `%I` would
# corrupt it into a path. `%I` in this file would fail the round-trip
# assertion tests/providers/exedev/image-assets.test.ts pins; the quotes stay
# anyway, because quoting a specifier costs nothing and un-quoting one is how
# the confusion starts.
ExecStart=/usr/local/bin/qds-engine run "%i"
#
# RUNID CHARSET, the other half of that contract. `%i` is the instance name
# AS-TYPED (`%I` is the C-unescaped form of it), and systemd does not run
# ExecStart through a shell or re-split a specifier
# expansion — so this is not an injection seam. It IS an argument the engine
# parses: `qds-run@a\x20b.service` hands it an argument containing a space, and
# nothing in DF2.10 constrains a runId. The accepted charset is `[A-Za-z0-9-]`
# (the shape `fleet run` already generates), and DF1.10 validates it HOST-SIDE
# before constructing the instance name — a unit file cannot reject its own
# instance name.
#
# NO `AssertPathExists=/usr/local/bin/qds-engine`, now that the path is real.
# The binary and this file arrive in the SAME image layer set — an image
# carrying one without the other cannot be built, because the Dockerfile runs
# `systemd-analyze verify` against this unit with the engine already installed.
# An assertion here would restate a build-time guarantee at run time and add a
# second, weaker place for that guarantee to live.

# NO [Install] SECTION, deliberately — its absence is the policy, not an
# omission. The only thing an [Install] section does is make
# `systemctl enable qds-run@<runId>` succeed, and an ENABLED instance is pulled
# in by multi-user.target on EVERY subsequent boot, re-walking phases whose git
# commits and LLM spend already happened. That is the same double-spend
# `Restart=no` above refuses, arriving through a different door — and exe.dev
# boxes do reboot (the image's growfs/tmpfs boot contract exists because they
# do). Nothing enables an instance today, but `enable` is the natural next verb
# for anyone who reads an [Install] section, and there was no DefaultInstance=
# either. Without the section `enable` fails loudly ("unit files have no
# installation config"), which is the behaviour the rest of this file asks for.
# DF1.10 starts a run with `systemctl start qds-run@<runId>` — a transient,
# host-decided act — never `enable`.
