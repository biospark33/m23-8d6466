# syntax=docker/dockerfile:1
#
# QDS-Factory enterprise image (story DF2.9) — the box that carries pi plus the
# vendored coms substrate into a client VPC.
#
# Build it with `bun run build:image`, never a bare `docker build`: the sweep
# that produces `oci/.build/NOTICE` runs BETWEEN the two stages below, against
# the `deps` stage's real tree. A bare build of the `runtime` target would
# either fail on the missing NOTICE or ship a stale one.
#
# INV-5 (no credential in a layer): nothing here declares an ENV or ARG holding
# a secret, writes an .npmrc, or copies a git credential. The box's single
# spend-capped LLM key arrives at RUNTIME (v5 §6.2, D8). A build-time secret, if
# one is ever needed, uses a BuildKit `--mount=type=secret` — never an
# ENV/ARG value, which persists into the layer history.

# The image the runtime stage takes its dependency tree FROM. `build-image.ts`
# passes the exact image ID of the `deps` stage it swept, so the tree that ships
# is provably the tree that was classified. Without this the runtime build
# re-resolves `deps` and would silently ship a different tree on any cache miss
# — `npm install` has no lockfile here, and the pi libs float inside 0.55.x.
ARG DEPS_IMAGE=deps

# ── deps ────────────────────────────────────────────────────────────────────
# The tree the license sweep classifies. `--omit=optional` drops
# @mariozechner/clipboard and its native binaries: no authoritative license
# text exists anywhere in that chain, and it is display-gated, so a headless
# VPC container never loads it.
# F084: digest-pinned, not `node:22-bookworm-slim`. The mutable tag re-resolves
# on every cold build, so every OS package in the shipped image floats outside
# the pinning this file is otherwise fanatical about (pi at 0.55.0, the swept
# tree threaded through DEPS_IMAGE). This is the multi-arch index digest, so it
# still resolves per-platform.
#
# BUMP PROCEDURE: `docker buildx imagetools inspect node:22-bookworm-slim` and
# copy the top-level `Digest:` value into BOTH FROM lines below (they must stay
# identical — the runtime stage copies the deps stage's tree). Then re-run
# `bun run build:image`; the license sweep re-classifies the new tree and fails
# the build if anything left policy. Dependabot's `docker` ecosystem
# (.github/dependabot.yml) opens the bump PR weekly.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS deps

WORKDIR /app

# The pin is the version F6 proved end to end and the version
# pi-vs-claude-code-vendor peer-pins. Its transitive pi-lib deps legitimately
# float inside 0.55.x; the sweep records their observed versions and fails only
# if one leaves that line.
RUN npm install --omit=optional --no-audit --no-fund --loglevel=warn \
      @mariozechner/pi-coding-agent@0.55.0 \
 && npm cache clean --force \
 && rm -rf /root/.npm

# ── the swept tree, pinned ──────────────────────────────────────────────────
# Resolves to the `deps` stage above by default, or to the exact image ID the
# sweep ran against when `build-image.ts` passes --build-arg DEPS_IMAGE.
FROM ${DEPS_IMAGE} AS swept

# ── runtime ─────────────────────────────────────────────────────────────────
# F084: same digest as the `deps` stage above — see the bump procedure there.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS runtime

LABEL org.opencontainers.image.title="qds-factory" \
      org.opencontainers.image.description="QDS-Factory enterprise box: pi coding agent + vendored coms substrate" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/biospark33/QDS-Factory"

WORKDIR /app

COPY --from=swept /app/node_modules /app/node_modules
COPY --from=swept /app/package.json /app/package.json

# The vendored coms substrate ships its own LICENSE (MIT (c) 2026 IndyDevDan)
# and `_provenance`, so it is covered without a NOTICE entry.
COPY pi-vs-claude-code-vendor/ /app/pi-vs-claude-code-vendor/

# Generated by scripts/generate-notice.ts from the `deps` tree above — see the
# header comment. The build fails before this line if the sweep did.
COPY oci/.build/NOTICE /usr/share/doc/qds-factory/NOTICE

USER node

# `pi-vs-claude-code-vendor/coms.ts` is loaded as a pi extension, not run
# standalone (its own header: "Usage: pi -e pi-vs-claude-code-vendor/coms.ts").
# `node_modules/.bin/pi` is the CLI @mariozechner/pi-coding-agent installs
# (`bin: pi` -> dist/cli.js). `node --version` here was a placeholder that
# never ran the agent this image exists to ship.
CMD ["node_modules/.bin/pi", "-e", "pi-vs-claude-code-vendor/coms.ts"]
