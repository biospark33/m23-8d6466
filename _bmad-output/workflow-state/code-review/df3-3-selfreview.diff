+    }
+  });
+
+  test("bin falls back to QDS_PI_BIN when opts.bin is absent", async () => {
+    const dir = caseDir("pibin");
+    process.env.QDS_PI_BIN = fakePi;
+    const spawn = enabled(
+      startResident({
+        brief: brief(),
+        runId: "run-pibin",
+        sessionDir: dir,
+        env: piEnv({ QDS_FAKE_PI_RECORD: join(dir, "record.json") }),
