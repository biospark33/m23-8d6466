+});
+
+describe("process-end mapping (exitStatus, CC-1 values)", () => {
+  test("timeout SIGKILL → call throws, exitStatus 'transient'", async () => {
+    const dir = caseDir("timeout");
+    process.env.QDS_RESIDENT_TIMEOUT_MS = "500";
