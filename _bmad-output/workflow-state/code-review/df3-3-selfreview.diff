+    await c.solicit("run_end", ctx()); // malformed × 2: replies 2 and 3
+    // per reply: round(100·100000/1e6)=10 + round(100·180000/1e6)=18 → 28 × 3
+    expect(c.telemetry.spendMicros).toBe(84);
