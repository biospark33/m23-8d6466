+    const spawn = enabled(
+      startResident({
+        brief: brief(),
+        runId,
+        sessionDir: dir,
+        bin: fakePi,
+        persistDir,
+        env: piEnv({
+          QDS_FAKE_PI_RECORD: join(dir, "record.json"),
+          QDS_FAKE_PI_PROMPT_PATH: promptPath,
+          // The reply echoes the secret: persisted reply must be redacted too.
