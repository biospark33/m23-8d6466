+import {
+  RETAIN_PAYLOAD_MAX_BYTES,
+  RunRetainError,
+  buildRetainPayload,
+  deriveDocumentId,
+  retainRunOutcome,
+  type RetainOutcome,
+  type RunRetainInput,
+} from "../../src/hindsight/run-retain.ts";
+
+// ---------------------------------------------------------------------------
+// Fixtures
+// ---------------------------------------------------------------------------
+
+let dir: string;
+let prevAuditEnv: string | undefined;
