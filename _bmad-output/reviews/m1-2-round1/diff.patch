+    requestId: "req-1",
+    hop: "memory-retain-receipt",
+    event: "retain",
+    subjectId: "doc-1",
+    subjectKind: "hindsight-document",
+    evidenceDigest: sha256Hex("subject"),
+    occurredAt: "2026-10-06T00:00:00.000Z",
+    recordedAt: "2026-10-06T00:00:00.001Z",
+    ...over,
+  };
+}
+
+function storedRows(path: string): { hop: string; event: string; subject_id: string | null }[] {
+  const db = new Database(path);
+  try {
+    return db.prepare("SELECT hop, event, subject_id FROM audit_links").all() as {
+      hop: string;
+      event: string;
+      subject_id: string | null;
+    }[];
+  } finally {
+    db.close();
+  }
+}
+
+function rowCount(path: string): number {
+  const db = new Database(path);
+  try {
+    return (db.prepare("SELECT COUNT(*) AS n FROM audit_links").get() as { n: number }).n;
+  } finally {
+    db.close();
+  }
+}
+
+/** The one typed refusal a thunk raises, narrowed — captured ONCE (see link-store.test.ts). */
+function refusalOf(fn: () => unknown): AuditStoreError {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof AuditStoreError) return e;
+    throw e;
+  }
+  throw new Error("expected an AuditStoreError, nothing was thrown");
+}
+
+describe("memory-retain-receipt vocabulary", () => {
+  test("event retain is accepted and lands exactly its row", () => {
+    const p = join(dir, "retain.db");
+    const store = openAuditStore(p);
+    store.record(receiptLink());
+    store.close();
+    expect(storedRows(p)).toEqual([{ hop: "memory-retain-receipt", event: "retain", subject_id: "doc-1" }]);
+  });
+
+  test("any other event on the hop is refused with the audit-link-invalid refusal", () => {
+    // The vocabulary is non-empty now, so the refusal arm is the VOCABULARY
+    // one — the machinery INV-AUDIT-4 used to hold this hop write-closed by
+    // emptiness now rejects by membership instead, and names the one allowed
+    // event in the message.
+    const p = join(dir, "refused.db");
+    const store = openAuditStore(p);
+    try {
+      for (const event of ["walk-observed", "mint", ""]) {
+        const e = refusalOf(() => store.record(receiptLink({ event })));
+        expect(e.code).toBe("audit-link-invalid");
+        expect(e.message).toMatch(/not in hop "memory-retain-receipt"'s vocabulary \(retain\)/);
+      }
+    } finally {
+      store.close();
+    }
+    // Fail loud BEFORE anything is written.
+    expect(rowCount(p)).toBe(0);
+  });
+
+  test("AUDIT_HOPS still holds exactly the previous ten hops, including memory-retain-receipt", () => {
+    expect([...AUDIT_HOPS]).toEqual([
+      "pr-run",
+      "run-issue",
+      "run-cost",
+      "run-credential",
+      "run-box",
+      "run-bundle",
+      "run-reverify",
+      "run-approval",
+      "run-gate-evidence",
+      "memory-retain-receipt",
+    ]);
+  });
+
+  test("the vocabulary row is exactly [retain]: every documented event of every other hop is refused", () => {
+    // `HOP_EVENT_VOCABULARY` is module-private, so exact membership is pinned
+    // behaviourally: `retain` in (above); every event any OTHER hop documents,
+    // plus near-miss spellings of retain, out. A future edit that grows the
+    // vocabulary is named by whichever entry this loop catches.
+    const p = join(dir, "exact.db");
+    const store = openAuditStore(p);
+    const elsewhere = [
+      "mint", "deliver", "revoke", "verify-revoked", // run-credential
+      "create", "fill", "setup-gate", "teardown", "reap", // run-box
+      "bundle-verify", "bundle-fetch", // run-bundle
+      "walk-observed", // pr-run / run-reverify / run-approval
+    ];
+    try {
+      for (const event of [...elsewhere, "retains", "Retain"]) {
+        const e = refusalOf(() => store.record(receiptLink({ event })));
+        expect(e.code).toBe("audit-link-invalid");
+        expect(e.message).toMatch(/not in hop "memory-retain-receipt"'s vocabulary \(retain\)/);
+      }
+    } finally {
+      store.close();
+    }
+    expect(rowCount(p)).toBe(0);
+  });
+});
diff --git a/tests/fleet/brief-schema-kgcontext.test.ts b/tests/fleet/brief-schema-kgcontext.test.ts
new file mode 100644
index 00000000..a46929b9
--- /dev/null
+++ b/tests/fleet/brief-schema-kgcontext.test.ts
@@ -0,0 +1,92 @@
+/**
+ * M1.2 AC3: the optional `kgContext` brief field — ceiling and charset
+ * enforced at the schema (INV-KG-3), absent-field v5 identity.
+ *
+ * The number 8_000 is pinned LITERALLY, not imported: the test exists to fail
+ * the day the schema's ceiling moves, and an exported constant the test reads
+ * would make that day a quiet pass. Same reasoning as the schema's own refusal
+ * to import the producer-side KG_CONTEXT_MAX_CHARS.
+ */
+import { describe, expect, test } from "bun:test";
+import type { ZodError } from "zod";
+
+import { BriefSchema, extractZodErrorField } from "../../src/fleet/brief-schema.ts";
+
+const BRIEF_KG_CONTEXT_MAX_CHARS = 8_000;
+
+function validBrief(over: Record<string, unknown> = {}): Record<string, unknown> {
+  return {
+    repoSlug: "owner/repo",
+    issueId: 123,
+    commitSha: "a".repeat(40),
+    manifestPath: "path/to/pipeline.json",
+    repoUrl: "https://github.com/owner/repo",
+    ...over,
+  };
+}
+
+/** The multi-line XML shape the producer (kg-context assembly) actually emits. */
+function kgBlock(lines: readonly string[]): string {
+  return ["<kg_context>", ...lines, "</kg_context>"].join("\n");
+}
+
+/**
+ * Assert the refusal is kgContext's OWN rule, not the fixture failing on an
+ * unrelated field — a bare .toThrow() cannot tell a charset refusal from a
+ * brief that stopped being valid for some other reason.
+ */
+function expectKgContextRejected(brief: Record<string, unknown>): void {
+  const result = BriefSchema.safeParse(brief);
+  expect(result.success).toBe(false);
+  const error = (result as { error: ZodError }).error;
+  expect(extractZodErrorField(error)).toBe("kgContext");
+}
+
+describe("kgContext brief schema", () => {
+  test("accepts an in-ceiling multi-line XML block, carried through verbatim", () => {
+    const block = kgBlock([
+      '\t<observation bank="qds-owner-repo" documentId="qds-20260920-abc123">',
+      "Run qds-20260920-abc123 exited 0; review latency p95 6m [cite:1]",
+      "\t</observation>",
+    ]);
+    const result = BriefSchema.safeParse(validBrief({ kgContext: block }));
+    expect(result.success).toBe(true);
+    expect((result as { data: { kgContext: string } }).data.kgContext).toBe(block);
+  });
+
+  test("refuses a value one char over the 8,000-char ceiling (never truncated)", () => {
+    expectKgContextRejected(validBrief({ kgContext: "x".repeat(BRIEF_KG_CONTEXT_MAX_CHARS + 1) }));
+  });
+
+  test("accepts a value exactly at the ceiling", () => {
+    const result = BriefSchema.safeParse(validBrief({ kgContext: "x".repeat(BRIEF_KG_CONTEXT_MAX_CHARS) }));
+    expect(result.success).toBe(true);
+  });
+
+  test("refuses every control-char class except newline and tab", () => {
+    // Each embedded mid-line in an otherwise-valid block: the block grammar is
+    // no defense, and \r especially must die inside it, not at some fold later.
+    const refused = ["\x00", "\x01", "\x0b", "\x0c", "\x0e", "\x1f", "\x7f", "\r"];
+    for (const ch of refused) {
+      expectKgContextRejected(validBrief({ kgContext: kgBlock([`line one${ch}line two`]) }));
+    }
+  });
+
+  test("newline and tab are the payload, not an attack", () => {
+    const result = BriefSchema.safeParse(
+      validBrief({ kgContext: kgBlock(["\tindented line", "second line"]) }),
+    );
+    expect(result.success).toBe(true);
+  });
+
+  test("absent field: parse output is the v5 object exactly", () => {
+    const without = BriefSchema.parse(validBrief());
+    const withField = BriefSchema.parse(validBrief({ kgContext: kgBlock(["obs [cite:1]"]) }));
+    expect("kgContext" in without).toBe(false);
+    const { kgContext: _present, ...rest } = withField;
+    expect(rest).toEqual(without);
+    // Byte-level, not just deep-equal: JSON.stringify is what crosses the seam
+    // into the shipped brief, so key ORDER is part of the v5 identity too.
+    expect(JSON.stringify(rest)).toBe(JSON.stringify(without));
+  });
+});
