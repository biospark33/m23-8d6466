+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "qds-m12-run-retain-"));
+  prevAuditEnv = process.env.QDS_AUDIT_DB;
+  process.env.QDS_AUDIT_DB = join(dir, "env-default-guard.db");
+});
